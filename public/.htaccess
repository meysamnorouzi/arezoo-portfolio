# Apache config for the static export (cPanel / shared hosting).
# Upload the CONTENTS of /out to public_html — this file included.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Content types ----------------------------------------------------------
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
AddType text/plain .txt

# Next.js writes these generated PNGs without a file extension.
<FilesMatch "^(opengraph-image|apple-icon)$">
  ForceType image/png
</FilesMatch>

# --- Redirects --------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Uncomment once an SSL certificate is active on the domain
  # (cPanel → SSL/TLS Status → AutoSSL), otherwise the site won't load.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Drop "www." so there is one canonical host. Remove if you prefer www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]

  # Old page URLs from earlier versions of the site.
  RewriteRule ^resume/?$ /about/ [L,R=301]
  RewriteRule ^playbook/?$ /how-i-build/ [L,R=301]
  RewriteRule ^partner/?$ /how-i-build/ [L,R=301]
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Caching ----------------------------------------------------------------
<IfModule mod_headers.c>
  # Pages: always revalidate so updates show up immediately.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images, icons, fonts, PDF: cache for 30 days.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(opengraph-image|apple-icon)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Hashed build assets never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
